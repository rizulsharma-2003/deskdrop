<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- DeskDrop runs inside the App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Multipeer Connectivity both initiates (client) and accepts (server) peer connections. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Received files are saved to ~/Downloads by default. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- Files the user drops or picks, and a user-chosen receiving folder. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Remember a user-chosen receiving folder across launches (security-scoped bookmark). -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Notification sounds must live in Library/Sounds, which inside the sandbox is a
	     link to ~/Library/Sounds. DeskDrop writes only its own DeskDrop*-prefixed files there. -->
	<key>com.apple.security.temporary-exception.files.home-relative-path.read-write</key>
	<array>
		<string>/Library/Sounds/</string>
	</array>
</dict>
</plist>
